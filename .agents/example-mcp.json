{
    "cloudflare-autorag": {
      "type": "http",
      "url": "https://autorag.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ..."
      }
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ..."
      }
    },
    "finhay": {
      "command": "bunx",
      "args": [
        "finhay-mcp-server"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ..."
      }
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "..."
      }
    },
    "agentmemory": {
      "command": "agentmemory",
      "args": [
        "mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "${AGENTMEMORY_URL:-http://localhost:3111}",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET:-}",
        "AGENTMEMORY_TOOLS": "${AGENTMEMORY_TOOLS:-all}"
      }
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp",
        "--tools",
        "all"
      ]
    },
    "obscura": {
      "command": "obscura",
      "args": ["mcp"]
    },
    "playwright": {
      "command": "@playwright/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {}
    },
    "codebase-memory-mcp": {
      "command": "/home/fxbite/.local/bin/codebase-memory-mcp"
    }
}